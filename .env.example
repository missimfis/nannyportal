# Copy this file to .env and fill in real values. Never commit .env.
SECRET_KEY=replace-with-a-long-random-value
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://example.com

# Enable only behind a trusted reverse proxy that normalizes X-Forwarded-Proto.
SECURE_PROXY_SSL_HEADER_ENABLED=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_AGE=28800
PASSWORD_RESET_TIMEOUT=3600

# Database (default SQLite). Use PostgreSQL in production.
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=5432

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Keep geocoding off the profile-save request path; run geocode_profiles periodically.
GEOCODE_ON_SAVE=False
GEOCODING_USER_AGENT=nannyportal
GEOCODING_DOMAIN=photon.komoot.io

PROFILE_IMAGE_MAX_BYTES=5242880
