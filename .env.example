# Copy this file to .env and fill in real values. Never commit .env.
SECRET_KEY=replace-with-a-long-random-value
ALLOWED_HOSTS=localhost,127.0.0.1

EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
DEFAULT_FROM_EMAIL=

STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
# Secret shown by `stripe listen` or in the Stripe Dashboard webhook settings.
STRIPE_WEBHOOK_SECRET=
